# Copy to .env and fill in from Supabase Dashboard > Project Settings > API.
# Vite only exposes variables prefixed with VITE_, and inlines them at build
# time -- these end up in the browser bundle, so never put a secret here.
# The anon key is safe to expose; row-level security is what protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave unset (or false) to keep the instance to the accounts that already
# exist. Set to true only alongside enabling sign-ups in the Supabase
# dashboard, which is where access is actually enforced.
VITE_ALLOW_SIGNUP=false
